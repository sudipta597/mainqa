# Environment Variables

# The API key required to connect to the Google Generative AI Service.
# Leave blank to use the Mock Mode (which only performs vector retrieval).
GOOGLE_API_KEY=

# File path to the document store
DATA_DIR=data

# LLM and Embedding Model configurations
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=gemini-1.5-flash

# Document splitting configurations
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
